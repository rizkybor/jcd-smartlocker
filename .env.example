# Contoh environment variable — HANYA nama variabel, JANGAN isi nilai asli di sini.
# Jangan pernah commit .env berisi nilai asli (lihat docs/PRD-Smartbox.md §7.1).
# Salin file ini jadi .env di masing-masing app (server/backend/.env, dst.) lalu isi sesuai environment (§14).

# --- Supabase (§9.2) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database via Prisma (§9.2, Epic 1) ---
# DATABASE_URL: pooled connection (pgbouncer, port 6543 di Supabase)
# DIRECT_URL: direct connection (port 5432), dipakai `prisma migrate`
DATABASE_URL=
DIRECT_URL=

# --- Payment provider (§8, abstraksi PaymentProvider §9.3) ---
PAYMENT_PROVIDER_ACTIVE=xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# --- WhatsApp Business API / BSP (§8) ---
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_SENDER_NUMBER=

# --- Cloudinary (§9.1, §9.2) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (§9.2) ---
REDIS_URL=

# --- MQTT broker / EMQX (§9.1) ---
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Observability (§9.4) ---
SENTRY_DSN=

# --- App ---
NODE_ENV=development
PORT=3000
