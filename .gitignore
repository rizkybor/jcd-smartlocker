# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
*.tsbuildinfo

# Stray compiled output from ad hoc `tsc`/`ts-node` runs outside dist/
# (mis. prisma/seed.js) — sumbernya tetap .ts, jangan commit hasil compile.
prisma/*.js
prisma/*.js.map
prisma/*.d.ts

# `tsc -b` composite build juga bisa emit vite.config.js/.d.ts di sebelah
# vite.config.ts (tsconfig.node.json referenced project) — bukan sumber.
client/*/vite.config.js
client/*/vite.config.d.ts

# Env — never commit real secrets (lihat docs/PRD-Smartbox.md §7.1)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor/OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test/coverage
coverage/
.turbo/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Supabase local
.supabase/

# Catatan lokal cara menjalankan server/client — bukan dokumentasi resmi,
# jangan ikut ter-commit.
run-app.md

# Caveman Packages
.agents
.claude
agent
skills-lock.json