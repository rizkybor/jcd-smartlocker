# Dipakai KHUSUS Playwright E2E (SMB-1104) — vite dev --mode e2e memuat
# file ini. Bukan project Supabase/backend asli — semua request ke sini
# di-intercept & di-mock lewat page.route() (lihat e2e/mocks.ts), TIDAK
# PERNAH benar-benar terhubung. Aman di-commit (bukan .env.e2e.local).
VITE_API_BASE_URL=http://localhost:4010
VITE_SUPABASE_URL=http://localhost:4011
VITE_SUPABASE_ANON_KEY=e2e-anon-key
VITE_SENTRY_DSN=
