# Salin jadi .env.local — JANGAN commit .env* berisi nilai asli.

VITE_API_BASE_URL=http://localhost:3000
# Sama seperti SUPABASE_URL/SUPABASE_ANON_KEY di server/backend/.env —
# login Supabase Auth terjadi langsung dari browser (client-side),
# service_role key TIDAK PERNAH ada di sini.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
