# Dipakai KHUSUS Playwright E2E (SMB-1103) — vite dev --mode e2e memuat file
# ini. Bukan URL asli, semua request ke sini di-intercept & di-mock lewat
# page.route() (lihat e2e/mocks.ts) — TIDAK PERNAH benar-benar terhubung ke
# backend sungguhan. Aman di-commit (tanpa nilai asli, bukan .env.e2e.local).
VITE_API_BASE_URL=http://localhost:4010
VITE_UNIT_KEY=e2e-test-unit-key
VITE_SENTRY_DSN=
