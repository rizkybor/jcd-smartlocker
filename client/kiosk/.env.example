# Salin jadi .env.local — JANGAN commit .env* berisi nilai asli.
# X-Unit-Key didapat dari response POST /company/units (Dashboard Company,
# Super Admin) — hanya ditampilkan sekali saat unit dibuat (docs/API-Contract-Smartbox.md §1.2).

VITE_API_BASE_URL=http://localhost:3000
VITE_UNIT_KEY=

# Observability (SMB-901, docs/PRD-Smartbox.md §9.4) — kosong = Sentry nonaktif.
VITE_SENTRY_DSN=
