{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/dashboard/**",
              "components/icons/**",
              "components/kiosk/**",
              "components/motion/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lexend|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Lexend, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|fullWidth|disabled|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, fullWidth, disabled, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|outline|ghost|danger)$/]",
        "message": "<Button> tone must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompartmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|state|selected|size|meta|statusLabel|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CompartmentCard> doesn't accept that prop. Declared props: id, state, selected, size, meta, statusLabel, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompartmentCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:available|occupied|offline)$/]",
        "message": "<CompartmentCard> state must be one of 'available' | 'occupied' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompartmentCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m|l|xl)$/]",
        "message": "<CompartmentCard> size must be one of 's' | 'm' | 'l' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|align|width|numeric|wrap|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, header, align, width, numeric, wrap, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DoorTransition'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|id|contentLabel|label|size|style|key|ref|className|style|children)$/]",
        "message": "<DoorTransition> doesn't accept that prop. Declared props: open, id, contentLabel, label, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|type|options|multiline|rows|hint|error|required|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, value, onChange, placeholder, type, options, multiline, rows, hint, error, required, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|basePath|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, basePath, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdleScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|subline|logoSrc|logoHeight|stats|footnote|onWake|style|key|ref|className|style|children)$/]",
        "message": "<IdleScreen> doesn't accept that prop. Declared props: headline, subline, logoSrc, logoHeight, stats, footnote, onWake, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KioskButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|fullWidth|disabled|lifted|icon|ariaLabel|onClick|style|key|ref|className|style|children)$/]",
        "message": "<KioskButton> doesn't accept that prop. Declared props: children, tone, size, fullWidth, disabled, lifted, icon, ariaLabel, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KioskButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|neutral|danger|success)$/]",
        "message": "<KioskButton> tone must be one of 'primary' | 'secondary' | 'neutral' | 'danger' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KioskButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<KioskButton> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Numpad'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|length|mask|label|style|key|ref|className|style|children)$/]",
        "message": "<Numpad> doesn't accept that prop. Declared props: value, onChange, length, mask, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|actions|elevation|tone|flush|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, description, actions, elevation, tone, flush, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:card|sunken)$/]",
        "message": "<Panel> tone must be one of 'card' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QRScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|qrSrc|qrSize|amount|secondsLeft|footer|style|key|ref|className|style|children)$/]",
        "message": "<QRScreen> doesn't accept that prop. Declared props: title, subtitle, qrSrc, qrSize, amount, secondsLeft, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|badge|section|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: id, label, icon, badge, section."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|deltaDirection|caption|accent|badge|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, unit, delta, deltaDirection, caption, accent, badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='deltaDirection'] > Literal[value!=/^(?:up|down|flat)$/]",
        "message": "<StatCard> deltaDirection must be one of 'up' | 'down' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:primary|accent|available|occupied|offline)$/]",
        "message": "<StatCard> accent must be one of 'primary' | 'accent' | 'available' | 'occupied' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|solid|size|pulse|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, solid, size, pulse, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|available|occupied|maintenance|offline|idle)$/]",
        "message": "<StatusBadge> status must be one of 'online' | 'available' | 'occupied' | 'maintenance' | 'offline' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<StatusBadge> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPulse'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|live|size|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusPulse> doesn't accept that prop. Declared props: status, live, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPulse'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:available|occupied|offline)$/]",
        "message": "<StatusPulse> status must be one of 'available' | 'occupied' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|compact|style|key|ref|className|style|children)$/]",
        "message": "<StepProgress> doesn't accept that prop. Declared props: steps, current, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuccessBurst'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<SuccessBurst> doesn't accept that prop. Declared props: title, detail, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuccessBurst'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|brand)$/]",
        "message": "<SuccessBurst> tone must be one of 'success' | 'brand'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
