# Salin jadi .env dan isi nilai asli — JANGAN commit .env berisi nilai asli.
# Daftar lengkap penjelasan variabel ada di .env.example root repo.

NODE_ENV=development
PORT=3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — DATABASE_URL: pooled connection (pgbouncer, port 6543 di Supabase)
# DIRECT_URL: direct connection (port 5432), dipakai `prisma migrate`
DATABASE_URL=
DIRECT_URL=

PAYMENT_PROVIDER_ACTIVE=xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Channel OTP ambil-barang (§5.2) — default "email" (Brevo) sementara
# WhatsApp BSP belum tersedia. Ganti ke "whatsapp" begitu siap.
OTP_CHANNEL_ACTIVE=email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Smartbox

WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_SENDER_NUMBER=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

REDIS_URL=

MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

SENTRY_DSN=
